rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.uid == userId;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'theme', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'theme', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.uid == userId &&
        data.theme is string &&
        data.theme in ['dark', 'light'] &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCloudDocument(data, userId, docId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'title',
          'format',
          'folder',
          'starred',
          'updatedLabel',
          'contentHtml',
          'comments',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'ownerId',
          'title',
          'format',
          'folder',
          'starred',
          'updatedLabel',
          'contentHtml',
          'pdfBase64',
          'slides',
          'comments',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == docId &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 200 &&
        data.format is string &&
        data.format in ['DOCX', 'DOC', 'PDF', 'PPTX', 'PPT', 'TXT'] &&
        data.folder is string &&
        data.folder.size() >= 1 &&
        data.folder.size() <= 80 &&
        data.starred is bool &&
        data.updatedLabel is string &&
        data.updatedLabel.size() >= 1 &&
        data.updatedLabel.size() <= 64 &&
        data.contentHtml is string &&
        data.contentHtml.size() <= 750000 &&
        (!('pdfBase64' in data) || (data.pdfBase64 is string && data.pdfBase64.size() <= 750000)) &&
        (!('slides' in data) || (data.slides is list && data.slides.size() <= 200 && (data.slides.size() == 0 || data.slides[0] is map))) &&
        data.comments is list &&
        data.comments.size() <= 500 &&
        (data.comments.size() == 0 || data.comments[0] is map) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isVerifiedOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'theme',
          'updatedAt'
        ]);
      allow delete: if isVerifiedOwner(userId) && isValidId(userId);

      match /documents/{docId} {
        allow get: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          existing().ownerId == request.auth.uid &&
          parentUserExists(userId);
        allow list: if isVerifiedOwner(userId) &&
          existing().ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidCloudDocument(incoming(), userId, docId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);
        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidCloudDocument(incoming(), userId, docId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId) &&
          (
            // Action: Toggle Star
            incoming().diff(existing()).affectedKeys().hasOnly(['starred', 'updatedLabel', 'updatedAt']) ||
            // Action: Rename
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedLabel', 'updatedAt']) ||
            // Action: Sync Content / Metadata
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'folder',
              'starred',
              'updatedLabel',
              'contentHtml',
              'pdfBase64',
              'slides',
              'comments',
              'updatedAt'
            ])
          );
        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          existing().ownerId == request.auth.uid &&
          parentUserExists(userId);
      }
    }
  }
}
